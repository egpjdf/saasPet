includes:
    - vendor/laravel/framework/src/Illuminate/Support/Stubs/*

parameters:
    level: 5
    paths:
        - app
        - config
        - database/factories
        - database/seeders
        - routes
        - tests
    excludePaths:
        - tests/Browser
        - .github
        - storage
        - bootstrap/cache
        - vendor

    # PHPStan settings
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    treatPhpDocTypesAsCertain: false
    checkAlwaysTrueInstanceof: true
    checkAlwaysFalseInstanceof: true
    checkMissingNullableReturnType: true

    # Laravel specific
    bootstrapFiles:
        - bootstrap/app.php

    # Ignore errors
    ignoreErrors:
        - '#^Dynamic method call#'
        - '#^Access to an undefined property#'
        - '#^Property .* does not exist#'

    # Extensions
    extensions:
        - PHPStan\ExtensionInstaller